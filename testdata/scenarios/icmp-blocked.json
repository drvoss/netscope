    { "kind": "probe", "tMs": 1200, "ttl": 3, "attempt": 6,  "outcome": "Timeout" },
    { "kind": "snapshot", "tMs": 1300 },

    { "kind": "probe", "tMs": 2000, "ttl": 1, "attempt": 7,  "outcome": "Timeout" },
